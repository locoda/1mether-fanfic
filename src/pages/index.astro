---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { chaptersOf } from '../lib/works';

const works = await getCollection('works');
const withCounts = await Promise.all(works.map(async (w) => ({
  work: w, chapters: await chaptersOf(w.slug),
})));
withCounts.sort((a, b) => {
  const da = a.work.data.updated?.getTime() ?? 0;
  const db = b.work.data.updated?.getTime() ?? 0;
  return db - da;
});
---
<Base>
  <h1>全部作品</h1>
  {withCounts.length === 0 && <p>还没有作品。按 README 的三步，加一个作品文件夹即可。</p>}
  {withCounts.map(({ work, chapters }) => (
    <article class="card">
      <h2><a href={`${import.meta.env.BASE_URL}works/${work.slug}/`}>{work.data.title}</a></h2>
      <p class="meta">
        {work.data.pairing && <span>{work.data.pairing} · </span>}
        {work.data.fandom && <span>{work.data.fandom} · </span>}
        {work.data.status} · {chapters.length} 章
        {work.data.updated && <span> · 更新于 {work.data.updated.toISOString().slice(0, 10)}</span>}
      </p>
      <p>{work.data.summary}</p>
      <p>{work.data.tags.map((t) => <span class="tag"><a href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(t)}/`}>{t}</a></span>)}</p>
    </article>
  ))}
</Base>
