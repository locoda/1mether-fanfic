---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { chaptersOf } from '../lib/works';

const works = await getCollection('works');
const withChapters = await Promise.all(works.map(async (w) => ({
  work: w,
  chapters: await chaptersOf(w.slug),
})));
// 按更新时间倒序，只用于排序，页面上不显示日期。
withChapters.sort((a, b) => {
  const da = a.work.data.updated?.getTime() ?? 0;
  const db = b.work.data.updated?.getTime() ?? 0;
  return db - da;
});
const firstChapterUrl = (workSlug: string, chapters: any[]) => {
  const first = chapters[0];
  const part = first.slug.split('/').slice(1).join('/');
  return `${import.meta.env.BASE_URL}works/${workSlug}/${part}/`;
};
---
<Base>
  <h1 class="page-title">全部作品</h1>
  {withChapters.length === 0 && <p>还没有作品。</p>}
  <ul class="work-list">
    {withChapters.map(({ work, chapters }) => (
      <li>
        {work.data.pairing && <span class="work-cp">{work.data.pairing}</span>}
        <a class="work-title" href={firstChapterUrl(work.slug, chapters)}>{work.data.title}</a>
        <span class="work-meta">
          {work.data.updated && <span>{work.data.updated.toISOString().slice(0, 10)}</span>}
          {chapters.length > 1 && <span> · {chapters.length} 章</span>}
        </span>
      </li>
    ))}
  </ul>
</Base>
