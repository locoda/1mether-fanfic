---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { chaptersOf, workSlugOf } from '../../../lib/works';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((c) => ({
    params: { work: workSlugOf(c.slug), chapter: c.slug.split('/').slice(1).join('/') },
    props: { chapter: c },
  }));
}

const { chapter } = Astro.props;
const works = await getCollection('works');
const work = works.find((w) => w.slug === Astro.params.work);
if (!work) throw new Error(`作品不存在：${Astro.params.work}`);
const chapters = await chaptersOf(work.slug);
const idx = chapters.findIndex((c) => c.slug === chapter.slug);
const prev = idx > 0 ? chapters[idx - 1] : null;
const next = idx < chapters.length - 1 ? chapters[idx + 1] : null;
const { Content } = await chapter.render();
const chapterUrl = (c: typeof chapter) => `${import.meta.env.BASE_URL}works/${work.slug}/${c.slug.split('/').slice(1).join('/')}/`;
const homeUrl = import.meta.env.BASE_URL;
---
<Base title={`${chapter.data.title} · ${work.data.title}`}>
  <p class="eyebrow"><a href={homeUrl}>全部作品</a> / {work.data.pairing && <span>{work.data.pairing} · </span>}{work.data.title}</p>
  <h1 class="chapter-title">{chapter.data.title}</h1>
  {chapters.length > 1 && <p class="chapter-count">第 {chapter.data.order} 章 / 共 {chapters.length} 章</p>}
  <div class="chapter-body"><Content /></div>
  <nav class="chapter-nav" aria-label="章节导航">
    <span>{prev && <a class="nav-btn" href={chapterUrl(prev)}>← 上一章：{prev.data.title}</a>}</span>
    <span>{next && <a class="nav-btn next-btn" href={chapterUrl(next)}>下一章：{next.data.title} →</a>}</span>
  </nav>
  {chapters.length > 1 && (
    <details class="chapter-list-box">
      <summary>全部章节</summary>
      <ol class="chapter-list">
        {chapters.map((c) => (
          <li class={c.slug === chapter.slug ? 'current' : ''}>
            {c.slug === chapter.slug
              ? <span>{c.data.title}</span>
              : <a href={chapterUrl(c)}>{c.data.title}</a>}
          </li>
        ))}
      </ol>
    </details>
  )}
</Base>
