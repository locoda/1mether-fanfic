---
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { site, ui } from '../../../site.config';
import { loadWorks, loadSeries, cpUrl, seriesUrl, fmtDate, countWords, type WorkInfo, type Chapter } from '../../../lib/works';

export async function getStaticPaths() {
  const works = await loadWorks();
  return works.flatMap((w) => w.chapters.map((c) => ({
    params: { work: w.slug, chapter: c.key },
    props: { work: w, chapter: c },
  })));
}

const { work, chapter } = Astro.props as { work: WorkInfo; chapter: Chapter };
const chapters = work.chapters;
const idx = chapters.findIndex((c) => c.slug === chapter.slug);
const prev = chapters[idx - 1];
const next = chapters[idx + 1];
const multi = chapters.length > 1;
const isLast = idx === chapters.length - 1;
const { Content } = await render(chapter.entry);
const chapterWords = countWords(chapter.entry.body ?? '');
const chapterMinutes = Math.max(1, Math.round(chapterWords / site.readingSpeed));
// 单章作品里，章节标题常常就是作品名，重复就不显示
const showChapterTitle = multi || chapter.title.trim() !== work.title.trim();

// 系列：本作的前后篇
const seriesGroup = work.series ? (await loadSeries()).find((s) => s.name === work.series) : undefined;
const sIdx = seriesGroup ? seriesGroup.works.findIndex((w) => w.slug === work.slug) : -1;
const prevWork = seriesGroup?.works[sIdx - 1];
const nextWork = seriesGroup?.works[sIdx + 1];

// 文末左右翻页：先找本作的上/下一章；到头了就接系列的上/下一篇
type Link = { href: string; label: string; title: string };
const prevLink: Link | undefined = prev
  ? { href: prev.url, label: ui.prevChapter, title: prev.title }
  : prevWork ? { href: prevWork.url, label: ui.prevInSeries, title: prevWork.title } : undefined;
const nextLink: Link | undefined = next
  ? { href: next.url, label: ui.nextChapter, title: next.title }
  : nextWork ? { href: nextWork.url, label: ui.nextInSeries, title: nextWork.title } : undefined;

// 同 CP 的其他作品（最近 5 篇，排除同系列已列出的）
const all = await loadWorks();
const inSeries = new Set(seriesGroup?.works.map((w) => w.slug) ?? []);
const related = work.cps.length
  ? all.filter((w) => w.slug !== work.slug && !inSeries.has(w.slug) && w.cps.some((c) => work.cps.includes(c))).slice(0, 5)
  : [];
---
<Base title={multi ? `${chapter.title} · ${work.title}` : work.title} description={work.dek}>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header class="article-head">
      {(work.cps.length > 0 || work.series) && (
        <p class="rubric">
          {work.cps.map((cp, i) => <>{i > 0 && <span class="sep">/</span>}<a href={cpUrl(cp)}>{cp}</a></>)}
          {work.cps.length > 0 && work.series && <span class="sep">·</span>}
          {work.series && <a href={seriesUrl(work.series)}>{work.series}</a>}
        </p>
      )}
      <h1>{work.title}</h1>
      {showChapterTitle && (
        <p class="chapter-title">{multi && <span class="no">{String(idx + 1).padStart(2, '0')}</span>}{chapter.title}</p>
      )}
      <p class="byline">{ui.byline(site.author)}</p>
      <div class="meta">
        {work.updated && <time datetime={fmtDate(work.updated)}>{fmtDate(work.updated)}</time>}
        {multi && (
          <details class="ch-picker">
            <summary aria-label={ui.allChapters}>{ui.chapterOf(idx + 1, chapters.length)}<span class="caret" aria-hidden="true"></span></summary>
            <ol>
              {chapters.map((c, i) => (
                <li class={c.slug === chapter.slug ? 'current' : ''}>
                  <a href={c.url} aria-current={c.slug === chapter.slug ? 'page' : undefined}>
                    <span class="no">{String(i + 1).padStart(2, '0')}</span>{c.title}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}
        <span>{ui.words(chapterWords)}</span>
        <span>{ui.minutes(chapterMinutes)}</span>
      </div>
    </header>
    <div class={`chapter-body${isLast ? ' is-end' : ''}`}><Content /></div>
  </article>

  <div class="article-foot">
    {(prevLink || nextLink) && (
      <nav class="pn" aria-label="翻页">
        {prevLink && (
          <a class="pn-prev" href={prevLink.href} rel="prev">
            <span class="label">{prevLink.label}</span>
            <span class="pn-t"><span class="arrow" aria-hidden="true">←</span>{prevLink.title}</span>
          </a>
        )}
        {nextLink && (
          <a class="pn-next" href={nextLink.href} rel="next">
            <span class="label">{nextLink.label}</span>
            <span class="pn-t">{nextLink.title}<span class="arrow" aria-hidden="true">→</span></span>
          </a>
        )}
      </nav>
    )}

    <div class="drawers">
      {multi && (
        <details class="drawer">
          <summary>
            <span class="d-t">{ui.allChapters}</span>
            <span class="d-m">{chapters.length} {ui.chapters}</span>
            <span class="d-i" aria-hidden="true"></span>
          </summary>
          <ol class="toc">
            {chapters.map((c, i) => (
              <li class={c.slug === chapter.slug ? 'current' : ''}>
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                {c.slug === chapter.slug ? <span aria-current="page">{c.title}</span> : <a href={c.url}>{c.title}</a>}
              </li>
            ))}
          </ol>
        </details>
      )}

      {seriesGroup && (
        <details class="drawer">
          <summary>
            <span class="d-t"><span class="d-k">{ui.inSeries}</span>{seriesGroup.name}</span>
            <span class="d-m">{ui.works(seriesGroup.works.length)}</span>
            <span class="d-i" aria-hidden="true"></span>
          </summary>
          <ol class="toc">
            {seriesGroup.works.map((w, i) => (
              <li class={w.slug === work.slug ? 'current' : ''}>
                <span class="no">{String(w.seriesOrder ?? i + 1).padStart(2, '0')}</span>
                {w.slug === work.slug ? <span aria-current="page">{w.title}</span> : <a href={w.url}>{w.title}</a>}
                <span class="m meta"><span>{ui.words(w.words)}</span></span>
              </li>
            ))}
          </ol>
          <p class="drawer-more"><a href={seriesUrl(seriesGroup.name)}>{ui.viewSeries} →</a></p>
        </details>
      )}

      {related.length > 0 && (
        <details class="drawer">
          <summary>
            <span class="d-t">{ui.moreFromCp(work.cps.join(' / '))}</span>
            <span class="d-m">{ui.works(related.length)}</span>
            <span class="d-i" aria-hidden="true"></span>
          </summary>
          <ul class="toc">
            {related.map((w) => (
              <li>
                <a href={w.url}>{w.title}</a>
                <span class="m meta">{w.updated && <span>{fmtDate(w.updated)}</span>}<span>{ui.words(w.words)}</span></span>
              </li>
            ))}
          </ul>
          <p class="drawer-more"><a href={cpUrl(work.cps[0])}>{ui.viewCp(work.cps[0])} →</a></p>
        </details>
      )}
    </div>
  </div>

  <script is:inline define:vars={{ prevHref: prevLink?.href ?? null, nextHref: nextLink?.href ?? null }}>
    // 阅读进度条
    const bar = document.querySelector('.progress');
    const body = document.querySelector('.chapter-body');
    if (!bar || !body) throw 0;
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
    // 顶部选章：点外面或按 Esc 收起，展开时把当前章滚到可见处
    const picker = document.querySelector('.ch-picker');
    if (picker) {
      picker.addEventListener('toggle', () => {
        if (picker.open) picker.querySelector('li.current')?.scrollIntoView({ block: 'nearest' });
      });
      document.addEventListener('click', (e) => { if (picker.open && !picker.contains(e.target)) picker.open = false; });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && picker.open) { picker.open = false; picker.querySelector('summary').focus(); } });
    }
    // 键盘 ← → 翻章
    addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || /input|textarea/i.test(e.target.tagName)) return;
      if (e.key === 'ArrowLeft' && prevHref) location.href = prevHref;
      if (e.key === 'ArrowRight' && nextHref) location.href = nextHref;
    });
  </script>
</Base>
