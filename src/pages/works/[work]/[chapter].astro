---
import Base from '../../../layouts/Base.astro';
import { site, ui } from '../../../site.config';
import { loadWorks, loadSeries, chapterUrl, cpUrl, seriesUrl, fmtDate, countWords, type WorkInfo, type Chapter } from '../../../lib/works';

export async function getStaticPaths() {
  const works = await loadWorks();
  return works.flatMap((w) => w.chapters.map((c) => ({
    params: { work: w.slug, chapter: c.slug.split('/').slice(1).join('/') },
    props: { work: w, chapter: c },
  })));
}

const { work, chapter } = Astro.props as { work: WorkInfo; chapter: Chapter };
const chapters = work.chapters;
const idx = chapters.findIndex((c) => c.slug === chapter.slug);
const prev = chapters[idx - 1];
const next = chapters[idx + 1];
const multi = chapters.length > 1;
const isLast = idx === chapters.length - 1;
const { Content } = await chapter.render();
const chapterWords = countWords(chapter.body);
const chapterMinutes = Math.max(1, Math.round(chapterWords / site.readingSpeed));
// 单章作品里，章节标题常常就是作品名，重复就不显示
const showChapterTitle = multi || chapter.data.title.trim() !== work.title.trim();

// 系列：本作的前后篇
const seriesGroup = work.series ? (await loadSeries()).find((s) => s.name === work.series) : undefined;
const sIdx = seriesGroup ? seriesGroup.works.findIndex((w) => w.slug === work.slug) : -1;
const prevWork = seriesGroup?.works[sIdx - 1];
const nextWork = seriesGroup?.works[sIdx + 1];

// 同 CP 的其他作品（最近 5 篇，排除同系列已列出的）
const all = await loadWorks();
const inSeries = new Set(seriesGroup?.works.map((w) => w.slug) ?? []);
const related = work.cps.length
  ? all.filter((w) => w.slug !== work.slug && !inSeries.has(w.slug) && w.cps.some((c) => work.cps.includes(c))).slice(0, 5)
  : [];
---
<Base title={multi ? `${chapter.data.title} · ${work.title}` : work.title} description={work.dek}>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header class="article-head">
      <p class="kicker">
        {work.cps.map((cp, i) => <>{i > 0 && <span class="sep">/</span>}<a href={cpUrl(cp)}>{cp}</a></>)}
        {work.cps.length > 0 && work.series && <span class="sep">·</span>}
        {work.series && <a href={seriesUrl(work.series)}>{work.series}{sIdx >= 0 && ` · ${ui.seriesPart(work.seriesOrder ?? sIdx + 1)}`}</a>}
      </p>
      <h1 class="work-title">{work.title}</h1>
      {showChapterTitle && <p class="chapter-title">{multi && `${String(chapter.data.order).padStart(2, '0')}　`}{chapter.data.title}</p>}
      <p class="byline">文 / {site.author}</p>
      <p class="meta">
        {work.updated && <time datetime={fmtDate(work.updated)}>{fmtDate(work.updated)}</time>}
        {multi && <span>{ui.chapterOf(idx + 1, chapters.length)}</span>}
        <span>{ui.words(chapterWords)}</span>
        <span>{ui.minutes(chapterMinutes)}</span>
      </p>
    </header>
    <div class={`chapter-body${isLast ? ' is-end' : ''}`}><Content /></div>
  </article>

  <aside class="article-foot">
    {multi && (
      <nav class="chapter-nav" aria-label="章节导航">
        {prev && <a class="prev" href={chapterUrl(prev)} rel="prev"><span class="dir">← {ui.prevChapter}</span>{prev.data.title}</a>}
        {next && <a class="next" href={chapterUrl(next)} rel="next"><span class="dir">{ui.nextChapter} →</span>{next.data.title}</a>}
      </nav>
    )}
    {multi && (
      <details class="toc" open={chapters.length <= 8}>
        <summary>{ui.allChapters}（{chapters.length}）</summary>
        <ol>
          {chapters.map((c) => (
            <li class={c.slug === chapter.slug ? 'current' : ''}>
              {c.slug === chapter.slug ? <span aria-current="page">{c.data.title}</span> : <a href={chapterUrl(c)}>{c.data.title}</a>}
            </li>
          ))}
        </ol>
      </details>
    )}

    {seriesGroup && (
      <section class="related">
        <p class="kicker">{ui.inSeries}</p>
        <h2><a href={seriesUrl(seriesGroup.name)}>{seriesGroup.name}</a></h2>
        <ol>
          {seriesGroup.works.map((w, i) => (
            <li class={w.slug === work.slug ? 'current' : ''}>
              <span class="part">{String(w.seriesOrder ?? i + 1).padStart(2, '0')}</span>
              {w.slug === work.slug ? <span aria-current="page">{w.title}</span> : <a href={w.url}>{w.title}</a>}
              <span class="meta"><span>{ui.words(w.words)}</span></span>
            </li>
          ))}
        </ol>
        {(prevWork || nextWork) && (
          <nav class="chapter-nav" style="margin-top:16px;border-top:0;padding-top:0" aria-label="系列导航">
            {prevWork && <a class="prev" href={prevWork.url}><span class="dir">← {ui.prevInSeries}</span>{prevWork.title}</a>}
            {nextWork && <a class="next" href={nextWork.url}><span class="dir">{ui.nextInSeries} →</span>{nextWork.title}</a>}
          </nav>
        )}
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <p class="kicker"><a href={cpUrl(work.cps[0])}>{ui.moreFromCp(work.cps.join(' / '))}</a></p>
        <ul>
          {related.map((w) => (
            <li>
              <a href={w.url}>{w.title}</a>
              <span class="meta">{w.updated && <span>{fmtDate(w.updated)}</span>}<span>{ui.words(w.words)}</span></span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </aside>

  <script is:inline define:vars={{ prevHref: prev ? chapterUrl(prev) : null, nextHref: next ? chapterUrl(next) : null }}>
    // 阅读进度条
    const bar = document.querySelector('.progress');
    const body = document.querySelector('.chapter-body');
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
    // 键盘 ← → 翻章
    addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || /input|textarea/i.test(e.target.tagName)) return;
      if (e.key === 'ArrowLeft' && prevHref) location.href = prevHref;
      if (e.key === 'ArrowRight' && nextHref) location.href = nextHref;
    });
  </script>
</Base>
