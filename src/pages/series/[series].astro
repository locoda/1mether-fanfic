---
import Base from '../../layouts/Base.astro';
import { site, ui } from '../../site.config';
import { loadSeries, url, cpUrl, fmtDate, type Group } from '../../lib/works';

export async function getStaticPaths() {
  const series = await loadSeries();
  return series.map((s) => ({ params: { series: s.slug }, props: { group: s } }));
}
const { group } = Astro.props as { group: Group };
const words = group.works.reduce((n, w) => n + w.words, 0);
---
<Base section="series" title={group.name} description={`${site.author} 的系列「${group.name}」`}>
  <div class="narrow">
    <p class="kicker"><a href={url('series/')}>{ui.seriesIndex}</a></p>
    <div class="section-head">
      <h1>{group.name}</h1>
      <span class="meta">{ui.works(group.works.length)} · {ui.words(words)}</span>
    </div>
    <ol class="work-list">
      {group.works.map((w, i) => (
        <li class="work-item">
          <p class="kicker">
            <span style="color:var(--muted)">{ui.seriesPart(w.seriesOrder ?? i + 1)}</span>
            {w.cps.map((cp) => <><span class="sep">·</span><a href={cpUrl(cp)}>{cp}</a></>)}
          </p>
          <h3 class="title"><a href={w.url}>{w.title}</a></h3>
          {w.dek && <p class="dek">{w.dek}</p>}
          <p class="meta">
            {w.updated && <time datetime={fmtDate(w.updated)}>{fmtDate(w.updated)}</time>}
            <span>{ui.words(w.words)}</span>
            {w.chapters.length > 1 && <span>{w.chapters.length} {ui.chapters}</span>}
          </p>
        </li>
      ))}
    </ol>
  </div>
</Base>
