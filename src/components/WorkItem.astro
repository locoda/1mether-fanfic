---
import { site, ui } from '../site.config';
import { cpUrl, seriesUrl, fmtDate, type WorkInfo } from '../lib/works';
interface Props { work: WorkInfo; showCp?: boolean }
const { work: w, showCp = true } = Astro.props;
const cps = showCp ? w.cps : [];
---
<li class="story">
  {(cps.length > 0 || w.series) && (
    <p class="rubric">
      {cps.map((cp, i) => <>{i > 0 && <span class="sep">/</span>}<a href={cpUrl(cp)}>{cp}</a></>)}
      {cps.length > 0 && w.series && <span class="sep">·</span>}
      {w.series && <a href={seriesUrl(w.series)}>{w.series}</a>}
    </p>
  )}
  <h3><a href={w.url}>{w.title}</a></h3>
  {w.dek && <p class="dek">{w.dek}</p>}
  <div class="side">
    {w.guestAuthor && <span>{w.author}</span>}
    {w.updated && <span><time datetime={fmtDate(w.updated)}>{fmtDate(w.updated)}</time></span>}
    {site.features.wordCount && <span>{ui.words(w.words)}</span>}
    {w.chapters.length > 1 && <span>{w.chapters.length} {ui.chapters}</span>}
    {w.status && <span>{w.status === 'ongoing' ? ui.ongoing : ui.finished}</span>}
  </div>
</li>
