---
import { ui } from '../site.config';
interface Props { current: number; last: number; href: (n: number) => string }
const { current, last, href } = Astro.props;
// 页码窗口：首页、末页、当前页前后各 1 页，其余用省略号
const pages: (number | '…')[] = [];
for (let n = 1; n <= last; n++) {
  if (n === 1 || n === last || Math.abs(n - current) <= 1) pages.push(n);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
---
{last > 1 && (
  <nav class="pager" aria-label="分页">
    {current > 1 && <a class="edge prev" href={href(current - 1)} rel="prev">← {ui.prev}</a>}
    {pages.map((p) => p === '…'
      ? <span class="gap">…</span>
      : p === current
        ? <span aria-current="page">{p}</span>
        : <a href={href(p)}>{p}</a>)}
    {current < last && <a class="edge next" href={href(current + 1)} rel="next">{ui.next} →</a>}
  </nav>
)}
