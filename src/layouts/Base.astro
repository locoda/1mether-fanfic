---
import { site } from '../site.config';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: #fff;
      color: #111;
      font-family: "Songti SC", "STSong", "Noto Serif SC", "SimSun", Georgia, "Times New Roman", serif;
      font-size: clamp(17px, 1.1vw + 14px, 19px);
      line-height: 1.95;
      letter-spacing: 0.01em;
    }
    a { color: inherit; text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 4px; }
    /* Masthead: magazine nameplate, thin double rule below */
    header.masthead {
      max-width: 760px;
      margin: 0 auto;
      padding: clamp(20px, 4vw, 36px) clamp(20px, 5vw, 32px) 0;
      text-align: center;
    }
    header.masthead .brand {
      font-size: clamp(30px, 6vw, 44px);
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1.2;
    }
    header.masthead nav {
      margin-top: 14px;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
    header.masthead nav a { color: #555; }
    header.masthead .rule {
      margin-top: 18px;
      border-top: 3px solid #111;
      border-bottom: 1px solid #111;
      height: 4px;
    }
    main {
      max-width: 680px;
      margin: 0 auto;
      padding: clamp(28px, 5vw, 48px) clamp(20px, 5vw, 32px) clamp(48px, 8vw, 80px);
    }
    footer {
      max-width: 680px;
      margin: 0 auto;
      padding: 20px clamp(20px, 5vw, 32px) 40px;
      border-top: 1px solid #ddd;
      text-align: center;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #888;
    }
    /* Contents page */
    .page-title {
      font-size: clamp(24px, 4vw, 30px);
      line-height: 1.3;
      margin: 0 0 28px;
      padding-bottom: 16px;
      border-bottom: 1px solid #111;
    }
    .work-list { list-style: none; margin: 0; padding: 0; }
    .work-list li {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid #eee;
    }
    .work-list .work-title { font-size: clamp(19px, 3vw, 22px); line-height: 1.5; }
    .work-list .work-cp {
      flex-shrink: 0;
      max-width: 42%;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 13px;
      color: #888;
      line-height: 1.5;
    }
    .work-list .work-meta {
      margin-left: auto;
      flex-shrink: 0;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 13px;
      color: #888;
      white-space: nowrap;
    }
    /* Article page: kicker, headline, drop cap */
    .eyebrow {
      margin: 0 0 12px;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #888;
    }
    .eyebrow a { color: #888; }
    .chapter-title {
      font-size: clamp(30px, 6vw, 44px);
      line-height: 1.25;
      letter-spacing: 0.02em;
      margin: 0 0 8px;
    }
    .chapter-count {
      margin: 0 0 28px;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 13px;
      letter-spacing: 0.12em;
      color: #888;
    }
    .chapter-body p { margin: 0 0 1em; text-align: justify; }
    .chapter-body > p:first-of-type::first-letter {
      float: left;
      font-size: 3.4em;
      line-height: 0.9;
      padding: 0.08em 0.12em 0 0;
      font-weight: 700;
    }
    .chapter-body h2 { font-size: 1.25em; margin: 1.8em 0 0.6em; }
    .chapter-body hr {
      border: none;
      margin: 2.2em 0;
      text-align: center;
    }
    .chapter-body hr::after {
      content: "···";
      letter-spacing: 0.6em;
      color: #999;
    }
    .chapter-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      margin-top: 48px;
      padding-top: 24px;
      border-top: 3px solid #111;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 14px;
    }
    .nav-btn {
      display: inline-block;
      border: 1px solid #111;
      padding: 10px 18px;
    }
    .nav-btn:hover { background: #111; color: #fff; text-decoration: none; }
    .chapter-list-box { margin-top: 32px; border-top: 1px solid #ddd; padding-top: 20px; }
    .chapter-list-box summary {
      cursor: pointer;
      font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
      font-size: 13px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #555;
    }
    .chapter-list { list-style: none; padding: 0; margin: 16px 0 0; }
    .chapter-list li { padding: 8px 0; border-bottom: 1px solid #eee; }
    .chapter-list li.current { color: #888; }
    /* Small screens: tighter masthead, stacked nav, smaller drop cap */
    @media (max-width: 640px) {
      body { line-height: 1.85; }
      header.masthead { padding-top: 16px; }
      main { padding-top: 24px; }
      .chapter-body > p:first-of-type::first-letter { font-size: 2.8em; }
      .chapter-nav { flex-direction: column; }
      .chapter-nav .nav-btn { display: block; text-align: center; }
      .work-list li { padding: 12px 0; flex-wrap: wrap; }
      .work-list .work-cp { max-width: 100%; }
      .work-list .work-meta { margin-left: 0; }
    }
  </style>
</head>
<body>
  <header class="masthead">
    <a class="brand" href={import.meta.env.BASE_URL}>{site.title}</a>
    <nav><a href={import.meta.env.BASE_URL}>全部作品</a></nav>
    <div class="rule"></div>
  </header>
  <main><slot /></main>
  <footer>© {site.author}</footer>
</body>
</html>
