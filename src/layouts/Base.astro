---
import { site } from '../site.config';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #faf9f6; color: #222; font-family: "Songti SC", "Noto Serif SC", serif; line-height: 1.9; }
    a { color: #1a4d8f; text-underline-offset: 3px; }
    header, main, footer { max-width: 720px; margin: 0 auto; padding: 0 20px; }
    header { padding-top: 32px; padding-bottom: 16px; border-bottom: 1px solid #ddd8cf; }
    header a.brand { color: inherit; text-decoration: none; font-size: 22px; font-weight: 700; }
    nav { margin-top: 8px; font-family: sans-serif; font-size: 14px; }
    nav a { margin-right: 16px; }
    main { padding-top: 28px; padding-bottom: 48px; }
    footer { padding-bottom: 32px; font-family: sans-serif; font-size: 13px; color: #777; border-top: 1px solid #ddd8cf; padding-top: 16px; }
    .meta { font-family: sans-serif; font-size: 14px; color: #666; line-height: 1.7; }
    .tag { display: inline-block; border: 1px solid #ccc; border-radius: 999px; padding: 1px 10px; margin: 0 6px 6px 0; font-size: 13px; }
    .tag a { color: inherit; text-decoration: none; }
    .card { border: 1px solid #ddd8cf; border-radius: 12px; padding: 20px 22px; margin-bottom: 20px; background: #fff; }
    .card h2 { margin: 0 0 6px; font-size: 21px; }
    .card h2 a { color: inherit; text-decoration: none; }
    .card p { margin: 6px 0; }
    .warnings { border: 1px solid #d9a441; background: #fff8e6; border-radius: 8px; padding: 12px 16px; margin: 16px 0; font-family: sans-serif; font-size: 14px; line-height: 1.7; }
    .chapter-nav { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd8cf; font-family: sans-serif; font-size: 15px; }
    .chapter-nav .next { margin-left: auto; text-align: right; }
    .chapter-list { list-style: none; padding: 0; }
    .chapter-list li { padding: 10px 0; border-bottom: 1px solid #eee; font-size: 17px; }
    .chapter-list li a { text-decoration: none; }
    .chapter-list .order { font-family: sans-serif; font-size: 13px; color: #888; margin-right: 10px; }
    h1 { font-size: 28px; line-height: 1.4; }
    h2 { font-size: 22px; }
    hr { border: none; border-top: 1px solid #ddd8cf; margin: 32px 0; }
  </style>
</head>
<body>
  <header>
    <a class="brand" href={import.meta.env.BASE_URL}>{site.title}</a>
    <nav>
      <a href={import.meta.env.BASE_URL}>全部作品</a>
      {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer>© {site.author} · 用 Markdown 写作，Astro 生成静态页</footer>
</body>
</html>
